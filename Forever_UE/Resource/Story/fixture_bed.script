{
	// 床(固定物品，没有AssetMod)：住宅房间mod在布局时用PlaceFixture放的，type="bed"，见Basic/map/room_residence.md。
	//   - 玩家走近弹"睡觉"；点了执行player_sleep：睡多久由玩家操控的市民的瞌睡值决定(Core的Citizen::SleepHoursFor，
	//     清醒16小时约睡7.5小时)，瞌睡值还在80%以上时不困、睡不了，只提示一句。睡的方式是跳时间(黑屏渐变由UE层做)，醒来瞌睡值回满。
	//   - 谁的床都能睡，不检查是不是玩家自己家；跳时间进行中再点会被忽略。
	"milestones": [
		{
			"milestone": "ready",
			"triggers": [ { "type": "game_start" } ],
			"visible": false,
			"drop": "true",
			"description": "",
			"goal": "",
			"changes": [
				{ "type": "add_option", "category": "asset", "name": "$$self.name", "option": "睡觉" }
			],
			"dialogs": [],
			"subsequences": []
		},
		{
			"milestone": "sleep",
			"triggers": [ { "type": "option_dialog", "name": "$$self.name", "option": "睡觉" } ],
			"visible": false,
			"drop": "false",
			"description": "",
			"goal": "",
			"changes": [
				{ "type": "player_sleep" }
			],
			"dialogs": [],
			"subsequences": []
		}
	]
}

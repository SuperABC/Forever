{
	// 手雷：扔出去(throw_asset事件，由投掷组件发给这件资产自己的脚本)后开始3秒引信，到时在落点生成爆炸特效并销毁自己。
	//   - create_timer用mode "real"(现实秒)：游戏时间默认1真实秒=10游戏分钟，3游戏秒几乎是瞬间；
	//   - spawn_effect的effect是mod提供的特效蓝图类路径(见Forever_Mod/README.md"用mod提供特效蓝图")，
	//     蓝图不存在/没装对应mod时不生成特效并打Warning(effect留空同样无特效)；
	//   - destroy_asset是延迟销毁(下一帧)，同一个里程碑里的两个Change按顺序执行没有问题。
	"milestones": [
		{
			"milestone": "thrown",
			"triggers": [ { "type": "throw_asset" } ],
			"visible": false,
			"drop": "true",
			"description": "",
			"goal": "",
			"changes": [
				{ "type": "create_timer", "name": "fuse", "time": "00:00:03", "mode": "real" }
			],
			"dialogs": [],
			"subsequences": []
		},
		{
			"milestone": "explode",
			"triggers": [ { "type": "time_up", "name": "fuse" } ],
			"visible": false,
			"drop": "true",
			"description": "",
			"goal": "",
			"changes": [
				{ "type": "spawn_effect", "effect": "\"/Test/Effect/BP_GrenadeExplosion\"", "scale": "1" },
				{ "type": "destroy_asset" }
			],
			"dialogs": [],
			"subsequences": []
		}
	]
}

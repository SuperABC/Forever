*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Precompiled/derived assets
**/SourceArt/**/*.png
**/SourceArt/**/*.tga
*_BuiltData.uasset


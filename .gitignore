# ---- Unreal Engine generated/cache folders (any project, any depth) ----
**/Binaries/
**/Intermediate/
**/DerivedDataCache/
**/Saved/
**/Build/
!**/Build/**/PakBlacklist*.txt
!**/Build/**/*.ico

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Precompiled/derived assets
**/SourceArt/**/*.png
**/SourceArt/**/*.tga
*_BuiltData.uasset

# ---- IDE / build-tool generated project files ----
**/.vs/
.vscode/
.idea/
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.user
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# ---- MSVC/MSBuild intermediate output (e.g. standalone VS projects under Source/) ----
**/x64/
**/x86/
*.tlog
*.lib.recipe
*.idb
*.ilk
*.pdb
*.lastbuildstate

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Claude Code runtime state ----
.claude/scheduled_tasks.lock

# ---- Blueprint text dumps (local scratch input for migration work, not repo content) ----
.dump/
